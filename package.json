{
  "name": "quiet-plot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"pnpm --filter @plot/server dev\" \"pnpm --filter @plot/web dev\"",
    "test": "pnpm --filter @plot/core test",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p apps/server --noEmit && tsc -p apps/web --noEmit",
    "build": "pnpm --filter @plot/web build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@12.9.1"
}
